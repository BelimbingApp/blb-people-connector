            "requires-modules": {
                "people-connector/connector": "*",
                "people-connector/skill": "*"
            },
            "optional-modules": {},
            "publishes-events": [
                "App\\Domains\\PeopleConnector\\Training\\Events\\TrainingCourseDefined",
                "App\\Domains\\PeopleConnector\\Training\\Events\\TrainingCourseDeactivated",
                "App\\Domains\\PeopleConnector\\Training\\Events\\TrainingCourseReactivated"
            ],
            "consumes-events": []
        }
    }
